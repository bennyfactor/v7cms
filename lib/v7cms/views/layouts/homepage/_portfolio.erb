<% items = defined?(@items) && @items ? @items : @posts %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Welcome Header -->
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4"><%= @page&.title || @settings.welcome_title %></h1>
    <% if @page&.content.present? %>
    <div class="text-xl text-gray-600 max-w-3xl mx-auto"><%= @page.content %></div>
    <% elsif @settings.welcome_subtitle.present? %>
    <p class="text-xl text-gray-600 max-w-3xl mx-auto"><%= @settings.welcome_subtitle %></p>
    <% end %>
  </div>

  <!-- Portfolio Grid -->
  <% if items.empty? %>
    <div class="text-center py-20">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-4">
        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h2 class="text-2xl font-semibold text-gray-900 mb-2">No content yet</h2>
      <p class="text-gray-600">Check back soon for new content.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% items.each do |item| %>
        <a href="/<%= item.is_a?(V7CMS::Post) ? 'posts' : 'pages' %>/<%= item.slug %>" class="group block relative overflow-hidden rounded-lg shadow-lg hover:shadow-2xl transition-shadow duration-300">
          <!-- Image Container with Aspect Ratio -->
          <div class="relative aspect-video bg-gradient-to-br from-blue-400 via-purple-500 to-pink-500 overflow-hidden">
            <% if item.respond_to?(:hero_image_url) && item.hero_image_url.present? %>
            <img src="<%= item.hero_image_url %>"
                 alt="<%= item.title %>"
                 class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
            <% else %>
            <!-- Placeholder gradient background (would be replaced with actual images when implemented) -->
            <div class="absolute inset-0 bg-gradient-to-br from-blue-400 via-purple-500 to-pink-500 group-hover:scale-110 transition-transform duration-500"></div>
            <% end %>

            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-90 group-hover:opacity-100 transition-opacity duration-300"></div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end">
              <h2 class="text-2xl font-bold !text-white mb-2 group-hover:translate-y-0 translate-y-1 transition-transform duration-300">
                <%= item.title %>
              </h2>

              <!-- Excerpt or Date - visible on hover -->
              <div class="text-gray-200 text-sm opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                <% if item.is_a?(V7CMS::Page) && item.content.present? %>
                  <p class="line-clamp-2"><%= item.content.gsub(/<[^>]*>/, '').strip.slice(0, 80) %>...</p>
                <% else %>
                  <div class="flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <time datetime="<%= item.created_at.iso8601 %>">
                      <%= item.created_at.strftime(@settings.date_format || '%B %d, %Y') %>
                    </time>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>
</div>

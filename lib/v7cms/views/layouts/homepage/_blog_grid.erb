<% items = defined?(@items) && @items ? @items : @posts %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Welcome Section -->
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4"><%= @page&.title || @settings.welcome_title %></h1>
    <% if @page&.content.present? %>
    <div class="text-xl text-gray-600"><%= @page.content %></div>
    <% elsif @settings.welcome_subtitle.present? %>
    <p class="text-xl text-gray-600"><%= @settings.welcome_subtitle %></p>
    <% end %>
  </div>

  <% if items.empty? %>
    <!-- Empty State -->
    <div class="text-center py-16">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
      </svg>
      <h3 class="mt-2 text-lg font-medium text-gray-900">No content yet</h3>
      <p class="mt-1 text-sm text-gray-500">Check back soon for new content!</p>
    </div>
  <% else %>
    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% items.each do |item| %>
        <article class="bg-white rounded-lg shadow-md overflow-hidden transition-all duration-200 hover:shadow-xl hover:-translate-y-1">
          <!-- Card Content -->
          <div class="p-6">
            <!-- Post Title -->
            <h2 class="text-2xl font-bold text-gray-900 mb-3 line-clamp-2">
              <a href="/<%= item.is_a?(V7CMS::Post) ? 'posts' : 'pages' %>/<%= item.slug %>" class="hover:text-blue-600 transition-colors">
                <%= item.title %>
              </a>
            </h2>

            <!-- Post Date -->
            <time class="text-sm text-gray-500 block mb-4" datetime="<%= item.created_at.iso8601 %>">
              <%= item.created_at.strftime(@settings.date_format) %>
            </time>

            <!-- Post Excerpt -->
            <% if item.content %>
              <div class="text-gray-600 mb-4 line-clamp-3">
                <%= item.content.gsub(/<\/?[^>]*>/, "").strip.slice(0, 150) %>...
              </div>
            <% end %>

            <!-- Read More Link -->
            <a href="/<%= item.is_a?(V7CMS::Post) ? 'posts' : 'pages' %>/<%= item.slug %>" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium transition-colors">
              Read more
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>

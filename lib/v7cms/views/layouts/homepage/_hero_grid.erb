<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Welcome Section -->
  <div class="text-center mb-12">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">
      <%= @settings.welcome_title %>
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
      <%= @settings.welcome_subtitle %>
    </p>
  </div>

  <% if @posts.empty? %>
    <!-- Empty State -->
    <div class="text-center py-16">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4">
        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
      <h2 class="text-2xl font-semibold text-gray-900 mb-2">No Posts Yet</h2>
      <p class="text-gray-600">Check back soon for new content!</p>
    </div>
  <% else %>
    <% hero_post = @posts.first %>
    <% grid_posts = @posts.drop(1) %>

    <!-- Hero Post -->
    <article class="mb-12 bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
      <a href="/posts/<%= hero_post.slug %>" class="block group">
        <div class="p-8 sm:p-12">
          <div class="flex items-center gap-3 text-sm text-gray-500 mb-4">
            <time datetime="<%= hero_post.created_at.iso8601 %>">
              <%= hero_post.created_at.strftime(@settings.date_format) %>
            </time>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              Featured
            </span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 group-hover:text-blue-600 transition-colors duration-200">
            <%= hero_post.title %>
          </h2>

          <% if hero_post.content %>
            <div class="prose prose-lg max-w-none text-gray-600 mb-6 line-clamp-3">
              <%= hero_post.content.gsub(/<[^>]*>/, '').strip[0..300] %>...
            </div>
          <% end %>

          <div class="flex items-center text-blue-600 font-semibold group-hover:text-blue-700">
            Read more
            <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </div>
      </a>
    </article>

    <% unless grid_posts.empty? %>
      <!-- Grid Posts -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <% grid_posts.each do |post| %>
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">
            <a href="/posts/<%= post.slug %>" class="block group">
              <div class="p-6">
                <time datetime="<%= post.created_at.iso8601 %>" class="text-sm text-gray-500 block mb-3">
                  <%= post.created_at.strftime(@settings.date_format) %>
                </time>

                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors duration-200 line-clamp-2">
                  <%= post.title %>
                </h3>

                <% if post.content %>
                  <div class="text-gray-600 mb-4 line-clamp-3">
                    <%= post.content.gsub(/<[^>]*>/, '').strip[0..150] %>...
                  </div>
                <% end %>

                <div class="flex items-center text-blue-600 font-medium text-sm group-hover:text-blue-700">
                  Read more
                  <svg class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<% @settings ||= V7CMS::Setting.instance %>
<article class="w-full">
    <!-- Full-width header banner -->
    <header class="bg-gradient-to-r from-gray-900 to-gray-700 text-white py-16 px-8 mb-12">
        <div class="max-w-5xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-bold mb-4"><%= @post.title %></h1>
            <div class="flex items-center text-gray-300 text-sm">
                <time datetime="<%= @post.created_at.iso8601 %>">
                    <%= @post.created_at.strftime(@settings.date_format) %>
                </time>
                <% if @post.updated_at != @post.created_at %>
                    <span class="mx-3">•</span>
                    <span>Updated <%= @post.updated_at.strftime(@settings.date_format) %></span>
                <% end %>
            </div>
        </div>
    </header>

    <!-- Wide content area -->
    <div class="max-w-5xl mx-auto px-8">
        <div class="prose prose-lg lg:prose-xl max-w-none">
            <%= @post.content %>
        </div>

        <footer class="mt-16 pt-8 border-t border-gray-200">
            <a href="/" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to all posts
            </a>
        </footer>
    </div>
</article>

<%= erb :'layouts/post/_comments', layout: false %>

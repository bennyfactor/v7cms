<% @settings ||= V7CMS::Setting.instance %>
<article class="max-w-4xl mx-auto">
    <!-- Large title header -->
    <header class="text-center py-12 border-b border-gray-200 mb-12">
        <div class="text-sm uppercase tracking-wider text-gray-500 mb-4">
            <time datetime="<%= @post.created_at.iso8601 %>">
                <%= @post.created_at.strftime(@settings.date_format) %>
            </time>
        </div>
        <h1 class="text-5xl md:text-6xl font-serif font-bold text-gray-900 mb-6 leading-tight">
            <%= @post.title %>
        </h1>
        <% if @post.updated_at != @post.created_at %>
            <p class="text-sm text-gray-500 italic">
                Updated <%= @post.updated_at.strftime(@settings.date_format) %>
            </p>
        <% end %>
    </header>

    <!-- Article content with drop cap styling -->
    <div class="prose prose-xl max-w-none prose-headings:font-serif prose-p:text-gray-700 prose-p:leading-relaxed first-letter:text-6xl first-letter:font-serif first-letter:font-bold first-letter:float-left first-letter:mr-3 first-letter:mt-1">
        <%= @post.content %>
    </div>

    <footer class="mt-16 pt-8 border-t border-gray-200 text-center">
        <a href="/" class="inline-flex items-center text-gray-600 hover:text-gray-900 font-medium transition">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to all posts
        </a>
    </footer>
</article>

<%= erb :'layouts/post/_comments', layout: false %>

<% @settings ||= V7CMS::Setting.instance %>
<article class="max-w-2xl mx-auto py-8">
    <header class="mb-12">
        <h1 class="text-3xl font-light text-gray-900 mb-3"><%= @post.title %></h1>
        <time datetime="<%= @post.created_at.iso8601 %>" class="text-sm text-gray-500">
            <%= @post.created_at.strftime(@settings.date_format) %>
        </time>
    </header>

    <div class="prose prose-lg max-w-none prose-headings:font-light prose-a:text-gray-900 prose-a:underline">
        <%= @post.content %>
    </div>

    <footer class="mt-12 pt-6">
        <a href="/" class="text-sm text-gray-500 hover:text-gray-900 transition">
            ← Back
        </a>
    </footer>
</article>

<%= erb :'layouts/post/_comments', layout: false %>

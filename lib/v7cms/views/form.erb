<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-lg shadow-md overflow-hidden p-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2"><%= @form.name %></h1>
    <% if @form.description.to_s.strip.length > 0 %>
      <p class="text-gray-600 mb-6"><%= @form.description %></p>
    <% end %>
    <%= @form_html %>
  </div>
</div>

<script src="/js/forms.js"></script>
<% if @form.require_recaptcha && ENV['RECAPTCHA_SITE_KEY'] %>
  <% recaptcha_enterprise = ENV['RECAPTCHA_PROJECT_ID'] && ENV['RECAPTCHA_API_KEY'] %>
  <% if recaptcha_enterprise %>
    <script src="https://www.google.com/recaptcha/enterprise.js?render=<%= ENV['RECAPTCHA_SITE_KEY'] %>"></script>
  <% else %>
    <script src="https://www.google.com/recaptcha/api.js?render=<%= ENV['RECAPTCHA_SITE_KEY'] %>"></script>
  <% end %>
  <script>
    window.RECAPTCHA_SITE_KEY = '<%= ENV['RECAPTCHA_SITE_KEY'] %>';
    window.RECAPTCHA_ENTERPRISE = <%= (recaptcha_enterprise ? true : false) %>;
  </script>
<% end %>

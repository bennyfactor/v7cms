<% @settings ||= V7CMS::Setting.instance %>
<% @theme ||= V7CMS::Theme.instance %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= @title ? "#{@title} - #{@settings.site_title}" : @settings.site_title %></title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>

    <!-- Tailwind v4 Theme Configuration -->
    <style type="text/tailwindcss">
      @theme {
<%= generate_theme_css(@theme, params) %>
      }

      /* Apply theme to elements - overrides Tailwind defaults */
      body {
        font-family: var(--font-body) !important;
        font-size: var(--font-size-base) !important;
        line-height: var(--line-height-base) !important;
        color: var(--color-text) !important;
        background: var(--color-background) !important;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading) !important;
        color: var(--color-heading) !important;
      }

      a {
        color: var(--color-link) !important;
      }

      a:hover {
        color: var(--color-link-hover) !important;
      }

      .container {
        max-width: var(--container-max);
      }

      .border, hr {
        border-color: var(--color-border) !important;
      }

      /* Override Tailwind utility classes */
      header.bg-white, footer.bg-white, article.bg-white {
        background-color: var(--color-background) !important;
      }
    </style>

    <% if @description %>
    <meta name="description" content="<%= @description %>">
    <% else %>
    <meta name="description" content="<%= @settings.meta_description %>">
    <% end %>

    <% if @settings.meta_keywords.present? %>
    <meta name="keywords" content="<%= @settings.meta_keywords %>">
    <% end %>

    <% if @settings.site_author.present? %>
    <meta name="author" content="<%= @settings.site_author %>">
    <% end %>

    <!-- RSS/Atom Feed Links -->
    <link rel="alternate" type="application/rss+xml" title="<%= @settings.site_title %> RSS Feed" href="/feed/rss">
    <link rel="alternate" type="application/atom+xml" title="<%= @settings.site_title %> Atom Feed" href="/feed/atom">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <%
      # Get header/footer styles (support preview mode via params)
      # Use respond_to? for backward compatibility with databases missing these columns
      default_header = @theme.respond_to?(:header_style) ? @theme.header_style : 'default'
      default_footer = @theme.respond_to?(:footer_style) ? @theme.footer_style : 'default'
      header_style = params[:theme_preview] ? (params[:header_style] || default_header) : default_header
      footer_style = params[:theme_preview] ? (params[:footer_style] || default_footer) : default_footer

      # Header style classes
      header_classes = case header_style
        when 'minimal' then 'bg-white border-b'
        when 'prominent' then 'bg-white shadow-lg'
        else 'bg-white shadow-sm'
      end
      header_padding = case header_style
        when 'minimal' then 'py-3'
        when 'prominent' then 'py-8'
        else 'py-6'
      end
      title_size = header_style == 'prominent' ? 'text-3xl' : 'text-2xl'
    %>
    <!-- Header -->
    <header class="<%= header_classes %>">
        <div class="max-w-4xl mx-auto px-4 <%= header_padding %>">
            <div class="flex justify-between items-center">
                <div>
                    <a href="/" class="<%= title_size %> font-bold text-gray-800 hover:text-blue-600 transition"><%= @settings.site_title %></a>
                    <% if @settings.site_tagline.present? && header_style != 'minimal' %>
                    <p class="text-sm text-gray-600 mt-1"><%= @settings.site_tagline %></p>
                    <% end %>
                </div>
                <nav class="flex space-x-6" id="main-nav">
                    <a href="/" class="text-gray-600 hover:text-gray-900 transition">Home</a>
                    <!-- Admin link injected via JavaScript -->
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
        <div class="max-w-4xl mx-auto px-4 py-8">
            <%= yield %>
        </div>
    </main>

    <!-- Footer -->
    <%
      # Footer style classes
      footer_classes = case footer_style
        when 'minimal' then 'bg-white border-t'
        when 'centered' then 'bg-white border-t'
        else 'bg-white border-t'
      end
      footer_padding = case footer_style
        when 'minimal' then 'py-3'
        when 'centered' then 'py-4'
        else 'py-6'
      end
      footer_text_size = footer_style == 'minimal' ? 'text-xs' : 'text-sm'
    %>
    <footer class="<%= footer_classes %> mt-auto">
        <div class="max-w-4xl mx-auto px-4 <%= footer_padding %> text-center text-gray-600 <%= footer_text_size %>">
            <p>
                <% if @settings.show_copyright_year %>
                &copy; <%= Time.now.year %>
                <% end %>
                <%= @settings.footer_text %>
            </p>
        </div>
    </footer>

    <!-- Auth-based UI injection -->
    <script>
        (async function() {
            try {
                const response = await fetch('/api/auth/me');
                const data = await response.json();

                if (data.logged_in) {
                    // Add admin link to navigation
                    const nav = document.getElementById('main-nav');
                    if (nav) {
                        const adminLink = document.createElement('a');
                        adminLink.href = '/admin/';
                        adminLink.className = 'text-gray-600 hover:text-gray-900 transition';
                        adminLink.textContent = 'Admin';
                        nav.appendChild(adminLink);
                    }

                    // Replace empty posts CTA with admin panel link
                    const emptyCta = document.getElementById('empty-posts-cta');
                    if (emptyCta) {
                        emptyCta.innerHTML = `
                            <p class="text-gray-500 mb-6">Get started by creating your first post in the admin panel.</p>
                            <a href="/admin/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg shadow transition">
                                Go to Admin Panel
                            </a>
                        `;
                    }
                }
            } catch (error) {
                console.error('Failed to check auth status:', error);
            }
        })();
    </script>
</body>
</html>

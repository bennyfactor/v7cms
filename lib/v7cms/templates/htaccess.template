# Disable directory browsing, enable symlink following (needed for gem assets)
Options -Indexes +FollowSymLinks

# Enable RewriteEngine for FastCGI routing
RewriteEngine On

# ============================================================================
# ALLOW OAuth routes before security rules
# ============================================================================
# Allow all /auth/ paths to pass through to the application
RewriteCond %{REQUEST_URI} ^/index\.fcgi/auth/
RewriteRule .* - [L]

# ============================================================================
# SECURITY: Block access to sensitive files and directories
# Returns 404 to hide existence rather than 403 which reveals the file exists
# ============================================================================

# Block ALL dotfiles and dot-directories (.env, .git, .gitignore, .htaccess, etc.)
# This is the primary defense against config/secret leaks
RedirectMatch 404 /\.

# Block access to any potential secrets/credential files by name pattern
# This matches files like secrets.txt, credentials.json but NOT /auth/ paths
RedirectMatch 404 /(secret|credential|password|token|key)s?\.(txt|json|yml|yaml|xml|ini|conf)$

# Block Ruby source files - return 404 for .rb, .ru, .rake files
RedirectMatch 404 \.(rb|ru|rake)$

# Block configuration files - YAML, JSON, INI, CONF
# BUT allow feed.xml and atom.xml (RSS/Atom feeds)
RedirectMatch 404 \.(yml|yaml|json|ini|conf|config)$
# Block XML files in subdirectories or with specific names (but not feed.xml/atom.xml in root)
RedirectMatch 404 /.+/.+\.xml$
RedirectMatch 404 ^/(config|database|settings|credentials|secret).*\.xml$

# Block database files - SQLite and related files
RedirectMatch 404 \.(db|sqlite|sqlite3|db-shm|db-wal|sql)$

# Block backup and temporary files
RedirectMatch 404 (\.(bak|backup|swp|swo|orig|tmp|old|save)|~)$

# Block log files
RedirectMatch 404 \.(log|logs)$

# Block common non-compiled source files
RedirectMatch 404 \.(md|markdown|txt|rst)$

# Block lock files
RedirectMatch 404 \.(lock)$

# Block sensitive files by exact name (case-insensitive)
RedirectMatch 404 /(?i)(gemfile|rakefile|dockerfile|docker-compose|readme|license|changelog|makefile)

# Block entire sensitive directories (db/, spec/, config/, app/, lib/, test/, bin/)
RedirectMatch 404 ^/(db|spec|config|app|lib|test|bin|tmp|log|vendor)/

# Block editor/IDE files
RedirectMatch 404 \.(sublime-project|sublime-workspace|code-workspace|iml|idea)$

# ============================================================================
# FALLBACK: Additional protection using FilesMatch (Apache 2.2/2.4 compatible)
# In case RedirectMatch rules don't catch everything
# ============================================================================

# Protect database files (double protection)
<FilesMatch "\.(db|sqlite|sqlite3|db-shm|db-wal|sql)$">
    # Apache 2.4
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    # Apache 2.2
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect Ruby source files (double protection)
<FilesMatch "\.(rb|ru|rake)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect configuration files (double protection)
# BUT allow feed.xml and atom.xml (RSS/Atom feeds)
<FilesMatch "\.(yml|yaml|json|ini|conf|config)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Note: XML file blocking removed because feeds are served dynamically through
# the application, not as static files. Config XML files in subdirectories
# are still blocked by RedirectMatch rules above.

# Protect documentation and source files
<FilesMatch "\.(md|markdown|txt|rst)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect backup files (double protection)
<FilesMatch "(\.(bak|backup|swp|swo|orig|tmp|old|save|log)|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================================
# CACHE CONTROL
# ============================================================================

# Disable mod_expires — we handle all caching via mod_headers.
# DreamHost's default mod_expires adds max-age to responses which
# conflicts with our no-cache directives on dynamic routes.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

# Long cache for static assets (30 days)
# These are fingerprinted or rarely change; browsers should cache aggressively
<FilesMatch "\.(js|css|wasm|woff|woff2|ttf|eot|otf|png|jpg|jpeg|gif|svg|ico|webp|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# theme.css is regenerated when theme settings change; keep it on a short cache
<Files "theme.css">
    Header set Cache-Control "public, max-age=3600"
</Files>

# Short cache for HTML files (admin SPA, pre-generated posts/pages)
# 1 hour lets content changes propagate reasonably fast
<FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# No-cache headers for dynamic content served through FastCGI.
# RewriteRule [E=VAR] creates REDIRECT_VAR after internal redirect,
# so we match the redirected variable name.
Header always set Cache-Control "no-cache, no-store, must-revalidate" env=REDIRECT_is_fcgi_request
Header always set Pragma "no-cache" env=REDIRECT_is_fcgi_request
Header always set Expires "0" env=REDIRECT_is_fcgi_request

# ============================================================================
# GZIP COMPRESSION
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/wasm
    AddOutputFilterByType DEFLATE application/xml text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================================
# CUSTOM REDIRECTS (auto-generated - do not edit manually)
# ============================================================================
{{REDIRECTS}}

# ============================================================================
# APPLICATION ROUTING: FastCGI handler
# ============================================================================

# Serve static assets from public/ subdirectories
# DocumentRoot is the repo root, not public/, so Apache can't find these
# without explicit rewrites. Without these rules, requests fall through to
# FCGI/Rack causing 1s+ TTFB instead of direct Apache serving at <50ms.
RewriteRule ^admin/?$ /public/admin/index.html [L]
RewriteRule ^admin/(.*)$ /public/admin/$1 [L]
RewriteRule ^js/(.*)$ /public/js/$1 [L]
RewriteRule ^css/(.*)$ /public/css/$1 [L]
RewriteRule ^patterns/(.*)$ /public/patterns/$1 [L]
# Serve pre-baked static HTML for clean post/page URLs
RewriteCond %{DOCUMENT_ROOT}/public/posts/$1/index.html -f
RewriteRule ^posts/([^/.]+)/?$ /public/posts/$1/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/public/pages/$1/index.html -f
RewriteRule ^pages/([a-z0-9-]+(/[a-z0-9-]+)*)/?$ /public/pages/$1/index.html [L]

# Root path must be explicitly rewritten so it gets the is_fcgi_request env var
# (DirectoryIndex would serve index.fcgi without setting it)
RewriteRule ^$ /index.fcgi/ [QSA,E=is_fcgi_request:1,L]

# Don't rewrite requests for existing files (CSS, JS, HTML, images, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
# Don't rewrite requests for existing directories
RewriteCond %{REQUEST_FILENAME} !-d
# Route everything else through index.fcgi (including /feed/rss and /feed/atom)
RewriteRule ^(.*)$ /index.fcgi/$1 [QSA,E=is_fcgi_request:1,L]

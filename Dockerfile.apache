FROM ruby:3.4-slim

# Install Apache, FastCGI, and dependencies
RUN apt-get update && apt-get install -y \
    apache2 \
    libapache2-mod-fcgid \
    build-essential \
    libsqlite3-dev \
    libfcgi-dev \
    && rm -rf /var/lib/apt/lists/*

# Enable Apache modules
RUN a2enmod rewrite fcgid headers

# Install bundler
RUN gem install bundler

# Set working directory
WORKDIR /var/www/v7cms

# Copy application files
COPY . /var/www/v7cms/

# Install gems in deployment mode (creates vendor/bundle)
RUN bundle config set --local deployment 'true'
RUN bundle config set --local path 'vendor/bundle'
RUN bundle install

# Copy .htaccess to public directory (DocumentRoot)
COPY .htaccess /var/www/v7cms/public/.htaccess

# Configure Apache with ScriptAlias for index.fcgi and set global FastCGI env vars
RUN echo 'FcgidInitialEnv BUNDLE_PATH /var/www/v7cms/vendor/bundle\n\
FcgidInitialEnv BUNDLE_DEPLOYMENT true\n\
FcgidInitialEnv BUNDLE_GEMFILE /var/www/v7cms/Gemfile\n\
FcgidInitialEnv GEM_HOME /var/www/v7cms/vendor/bundle/ruby/3.4.0\n\
FcgidInitialEnv GEM_PATH /var/www/v7cms/vendor/bundle/ruby/3.4.0\n\
\n\
<VirtualHost *:80>\n\
    ServerName localhost\n\
    DocumentRoot /var/www/v7cms/public\n\
    \n\
    # Allow access to the parent directory for index.fcgi\n\
    <Directory /var/www/v7cms>\n\
        Options +ExecCGI\n\
        Require all granted\n\
    </Directory>\n\
    \n\
    <Directory /var/www/v7cms/public>\n\
        Options -Indexes +FollowSymLinks\n\
        AllowOverride All\n\
        Require all granted\n\
    </Directory>\n\
    \n\
    # FastCGI configuration\n\
    FcgidMaxRequestLen 1073741824\n\
    AddHandler fcgid-script .fcgi\n\
    \n\
    # Map /index.fcgi to the script in parent directory\n\
    ScriptAlias /index.fcgi /var/www/v7cms/index.fcgi\n\
    \n\
    ErrorLog ${APACHE_LOG_DIR}/error.log\n\
    CustomLog ${APACHE_LOG_DIR}/access.log combined\n\
</VirtualHost>' > /etc/apache2/sites-available/v7cms.conf

# Enable the site
RUN a2ensite v7cms.conf
RUN a2dissite 000-default.conf

# Set up database
RUN bundle exec rake db:migrate RACK_ENV=production

# Generate feeds
RUN bundle exec rake feeds:regenerate RACK_ENV=production

# Ensure proper permissions
RUN chown -R www-data:www-data /var/www/v7cms
RUN chmod +x /var/www/v7cms/index.fcgi

# Set Bundler environment variables for FastCGI runtime
ENV BUNDLE_PATH=/var/www/v7cms/vendor/bundle \
    BUNDLE_DEPLOYMENT=true \
    BUNDLE_GEMFILE=/var/www/v7cms/Gemfile

EXPOSE 80

CMD ["apache2ctl", "-D", "FOREGROUND"]
